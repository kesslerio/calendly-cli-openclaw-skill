					const invitees = Array.isArray(event.invitees) ? event.invitees : [];
					const matchingInvitees = invitees.filter((invitee: any) =>
						typeof invitee?.email === 'string' && invitee.email.toLowerCase() === normalizedEmail
					);
					if (matchingInvitees.length > 0) {
						matches.push({ event, matching_invitees: matchingInvitees });
					}
				}

				pageToken = response.data.pagination?.next_page_token;
				if (!pageToken) break;
			}

			printResult({
				query: {
					email: normalizedEmail,
					user_uri: userUri,
					organization_uri: organizationUri,
					status,
					min_start_time: minStartTime,
					max_start_time: maxStartTime,
					page_size: pageSize,
					max_pages: maxPages,
				},
				meta: {
					pages_scanned: scannedPages,
					events_scanned: scannedEvents,
					matches: matches.length,
					has_more: scannedPages >= maxPages && Boolean(pageToken),
				},
				collection: matches,
			}, globalOptions.output ?? 'text');
		} catch (error) {
			const message = error instanceof Error ? error.message : String(error);
			console.error(`Error: ${message}`);
			process.exit(1);
